@model IEnumerable<Biblioteca.Web.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<h1>Autores</h1>

@if (TempData["MensagemSucesso"] is not null)
{
    <div class="alert alert-success">@TempData["MensagemSucesso"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Novo autor</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Nacionalidade</th>
            <th>Livros</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Nome</td>
                <td>@(autor.Nacionalidade ?? "-")</td>
                <td>
                    @if (autor.Livros.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var livro in autor.Livros)
                            {
                                <li>@livro.Titulo</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Nenhum livro cadastrado</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
