@model Biblioteca.Web.Models.Livro

@{
    ViewData["Title"] = "Detalhes do livro";
}

<h1>Detalhes do livro</h1>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@(Model.Autor?.Nome ?? "-")</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">R$ @Model.Preco.ToString("N2")</dd>

    <dt class="col-sm-2">Estoque</dt>
    <dd class="col-sm-10">@Model.QuantidadeEstoque</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
